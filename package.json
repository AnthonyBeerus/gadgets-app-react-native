{
  "name": "project-muse",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest",
    "test:coverage": "jest --coverage",
    "preflight:preview": "node scripts/preflight-preview.mjs",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview:android": "npm run preflight:preview && eas build --profile preview --platform android",
    "update:preview": "eas update --channel preview --platform android"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.28",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@hookform/resolvers": "^3.9.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/material-top-tabs": "^7.4.4",
    "@rneui/themed": "^4.0.0-rc.8",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@stripe/stripe-react-native": "0.63.0",
    "@supabase/supabase-js": "^2.45.1",
    "@tanstack/react-query": "^5.53.1",
    "aes-js": "^3.1.2",
    "ai": "^5.0.87",
    "cross-fetch": "^3.1.8",
    "date-fns": "^3.6.0",
    "expo": "~55.0.26",
    "expo-camera": "~55.0.19",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.17",
    "expo-dev-client": "~55.0.35",
    "expo-device": "~55.0.17",
    "expo-file-system": "~55.0.19",
    "expo-font": "~55.0.7",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-media-library": "~55.0.17",
    "expo-network": "~55.0.14",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.24",
    "lottie-react-native": "^7.3.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.52.2",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-pager-view": "8.0.0",
    "react-native-purchases": "^9.6.8",
    "react-native-purchases-ui": "^9.6.8",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-toast-notifications": "^3.4.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.7.4",
    "zod": "^3.25.76",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "12.3.7",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.18",
    "typescript": "^5.1.3"
  },
  "overrides": {
    "whatwg-fetch": "npm:cross-fetch@^3.1.8"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|zustand|@react-native/virtualized-lists|react-native-purchases)"
    ],
    "testMatch": [
      "**/__tests__/**/*.(test|spec).(ts|tsx|js)",
      "**/*.(test|spec).(ts|tsx|js)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "collectCoverage": false,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/__tests__/**"
    ]
  }
}
