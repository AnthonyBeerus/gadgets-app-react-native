{
  "expo": {
    "name": "Muse",
    "scheme": "muse",
    "slug": "rn-shop",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8f6f8",
      "dark": {
        "image": "./assets/splash-icon-dark.png",
        "backgroundColor": "#f8f6f8"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kaizenicai.muse",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "audio",
            "photo"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "kaizen-dynamics",
          "project": "muse"
        }
      ],
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": ""
        }
      ],
      "expo-font",
      "expo-image",
      "expo-notifications"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a2f2ee1e-65a2-4dbb-a3e7-8cb7ae8cd4f6"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a2f2ee1e-65a2-4dbb-a3e7-8cb7ae8cd4f6"
      }
    },
    "owner": "kaizenic-ai"
  }
}
